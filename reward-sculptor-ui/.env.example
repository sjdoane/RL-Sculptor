# Copy to .env and edit. All keys are optional; defaults are platform-aware.
# RS_PROJECTS_ROOT=C:\Users\you\AppData\Local\reward-sculptor\projects
# RS_ALLOW_CLOUD_SYNC=false
# RS_HOST=127.0.0.1
# RS_PORT=8000
# RS_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Shared with sculptor (required for live runs; leave blank for --dry-run)
# ANTHROPIC_API_KEY=
