# RL-Sculptor monorepo .gitignore
# Top-level: exclude sibling dirs that aren't part of this project.

# Unrelated capstone work
AME456/

# Claude Code internal memory
.claude/

# Python env marker
.python-version

# Research dumps (too large, not needed in the repo)
_eureka_fulltext.txt

# ---------------------------------------------------------------------
# Both subprojects share these exclusions

# Secrets
**/.env
**/.env.*
!**/.env.example

# Python / uv
**/.venv/
**/__pycache__/
**/*.py[cod]
**/*$py.class
**/.pytest_cache/
**/.mypy_cache/
**/.ruff_cache/
**/*.egg-info/
**/dist/
**/build/

# Node / frontend
**/node_modules/
**/frontend/dist/

# OS / editor
.DS_Store
Thumbs.db
.vscode/
.idea/

# ---------------------------------------------------------------------
# RewardSculptor local state (regeneratable)

RewardSculptor/runs/
RewardSculptor/kg/graph.db
RewardSculptor/kg/pdfs/
RewardSculptor/logs/
RewardSculptor/examples/hopper/runs/
RewardSculptor/examples/hopper_test/runs/
RewardSculptor/tests/fixtures/_mjlab_go1_work/
# Keep go1_smoke_checkpoint.pt (session fixture, ~4.7 MB) — tracked.

# ---------------------------------------------------------------------
# reward-sculptor-ui local state

reward-sculptor-ui/logs/
reward-sculptor-ui/backend/.pytest_cache/

# ---------------------------------------------------------------------
# Scratch / junk (never commit)

# Windows alternate-data-stream metadata
*:Zone.Identifier
# Botched-redirect / stray artifacts
=1
.thumbnail
RL-Sculptor.html
# UI design exploration scratch (1 MB of screenshots, superseded)
design-prototype/
# Scratch PR bodies + one-off analysis scripts
.pr-body-*.md
_agg.py
_agg2.py
_report.py
# Personal capstone seed (sibling AME456 work)
ame456_kg_seeds.yml
