# Copy to .env and fill in. .env is gitignored.

ANTHROPIC_API_KEY=sk-ant-...

# SCULPTOR_KG_PATH=./kg/graph.db

# Enforce each motor's real velocity (no-load speed) limit in the sim physics, in
# addition to the torque limit mjlab already clamps. Swaps the robot's actuators to
# mjlab's research-standard DcMotor torque-speed model so a policy physically cannot
# drive joints past the real no-load speed. DEFAULT ON. Set to 0 to disable (recover
# the old velocity-unconstrained physics). NOTE: a policy trained under one setting
# must be RE-TRAINED, not warm-started, if you change it.
# RS_ENFORCE_ACTUATOR_LIMITS=0
